{
  "name": "kixo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build && node scripts/sanitize-build.mjs && node scripts/check-artifact.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx scripts/run-tests.ts unit",
    "test:e2e": "node --import tsx scripts/run-tests.ts e2e",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node --import tsx prisma/seed.ts",
    "format": "prettier --write .",
    "db:check": "node --import tsx scripts/check-database.ts",
    "test:db:migrate": "node --import tsx scripts/run-tests.ts migrate",
    "test:db:seed": "node --import tsx scripts/run-tests.ts seed",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "release:check": "node --import tsx scripts/release-check.ts",
    "release:check:local": "node --import tsx scripts/release-check.ts --local",
    "db:backup": "node --import tsx scripts/backup-database.ts",
    "db:restore:test": "node --import tsx scripts/restore-test-backup.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.107.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^16.0.0",
    "next-auth": "^4.24.13",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
