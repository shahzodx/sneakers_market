# Copy to .env.production on your server; never commit real values.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&sslaccept=strict&sslcert=/app/certs/supabase-ca.pem&connection_limit=3&pool_timeout=30&connect_timeout=15"
NEXTAUTH_URL="https://your-domain.example"
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-48"
APP_MODE="demo"
NEXT_PUBLIC_STORE_MODE="demo"
# Set true only behind a proxy which overwrites X-Forwarded-For.
TRUST_PROXY="false"
STORE_CONTACT_EMAIL=""
STORE_CONTACT_PHONE=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
